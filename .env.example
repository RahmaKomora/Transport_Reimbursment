# Copy to .env. Everything here is optional: Songa holds its own data in SQLite and runs
# without any of it. Set SONGA_GOOGLE_CLIENT_ID before this handles anything real.

# Google Sign-In. While unset, sign-in falls back to matching a typed email against the
# directory — fine for the build phase, not safe for real claims.
# SONGA_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Only Workspace accounts in this domain may sign in, verified server side.
# SONGA_ALLOWED_DOMAIN=oneacrefund.org

# Addresses allowed in from outside that domain, comma separated. For test accounts.
# SONGA_EXTRA_ALLOWED_EMAILS=

# Sign session tokens. Any long random string; change it and everyone is signed out.
SONGA_SESSION_SECRET=change-me

SONGA_API_PORT=5175

# Where the database lives. Defaults to server/data/songa.db.
# SONGA_DB_PATH=

# How long the built directory is reused before it is rebuilt. Admin edits call for a
# rebuild immediately, so this only affects changes made outside the app.
# SONGA_DIRECTORY_TTL_MS=60000

# Who receives the cycle batch summary. Comma separated. No mail transport is wired up
# yet, so this is currently only reported in the log alongside the written report.
SONGA_HR_EMAILS=hr@oneacrefund.org

# Where batch reports are written. Defaults to server/reports.
# SONGA_REPORT_DIR=

# Set to true to run the API without the cycle cron jobs.
# SONGA_DISABLE_SCHEDULER=true
