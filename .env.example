# Copy to .env. Set SONGA_DATABASE_URL to run on Postgres; leave it unset and Songa falls
# back to a SQLite file, which is what a fresh checkout and the test suite use.
#
# On the cluster these arrive from Vault, one key per variable, spelled exactly as here.
# With NODE_ENV=production the API refuses to start without Postgres and without a real
# SONGA_SESSION_SECRET, rather than quietly running on SQLite or a public default.

# ---------------------------------------------------------------------- database -----

# Postgres. Configuring a connection here is what selects the Postgres backend — see
# server/db.js. Apply the schema with `npm run db:setup` afterwards.
#
# Two ways to spell it. Use one or the other, not both: a URL overrides the PG* variables
# key by key, so a leftover URL line would quietly win.
#
# Either one connection string, which is what a managed instance hands you:
#
#   postgres://user:password@host:5432/dbname
#
# A password with @ : / ? or # in it has to be percent-encoded, or the URL parses wrong.
# SONGA_DATABASE_URL=

# ...or libpq's own variables, which `pg` reads for itself. The names have to be exactly
# these. PGDATABASE is the one that selects the Postgres backend — PGHOST and PGUSER are
# often set in a shell for psql's benefit, and those alone must not silently repoint the
# app at a different database than it was configured for.
#
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=postgres
# PGSSLMODE=disable          # disable for a local server; require for a managed one

# The one schema this tool owns. Defaults to transport_reimbursement, and is created for
# you by `npm run db:setup`. Every table lives in here and never in `public`, and `public`
# is deliberately left out of the search_path — so an unqualified name that is not ours
# fails to resolve rather than quietly finding another tool's table of the same name.
# SONGA_DB_SCHEMA=transport_reimbursement

# TLS. Managed instances (Neon, Supabase, RDS) require it; a local one has no certificate
# and refuses it. Left unset, the sslmode in the URL above decides.
# SONGA_DATABASE_SSL=true

# Connections held open. The default of 10 is ample for 1,400 people on one instance.
# SONGA_DB_POOL_MAX=10

# Sign-in is by work email and password. A first password, and a reset, start from a
# one-time setup code an admin issues in Admin > User roles (or `npm run admin:unlock`).
#
# Optional: a Google button beside the password form, for anyone who would rather not
# keep a password. Its Authorised JavaScript origins must include the page's origin.
# SONGA_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Only Workspace accounts in this domain may sign in, verified server side.
# SONGA_ALLOWED_DOMAIN=oneacrefund.org

# Addresses allowed through Google from outside that domain, comma separated.
# SONGA_EXTRA_ALLOWED_EMAILS=

# Signs session tokens. A long random string — `openssl rand -base64 48` — and at least
# 32 characters in production. Change it and everyone is signed out.
SONGA_SESSION_SECRET=change-me

SONGA_API_PORT=5175

# How many proxies sit between a user and the API, so the sign-in rate limit sees the
# user's address and not a proxy's. 1 locally (the Vite proxy); 2 on the cluster (the
# ingress, then the web pod's nginx). Too low and one person's typos lock out everyone.
# SONGA_TRUST_PROXY_HOPS=1

# Where the SQLite file lives, when SONGA_DATABASE_URL is unset.
# Defaults to server/data/songa.db.
# SONGA_DB_PATH=

# How long the built directory is reused before it is rebuilt. Admin edits call for a
# rebuild immediately, so this only affects changes made outside the app.
# SONGA_DIRECTORY_TTL_MS=60000

# Who receives the cycle batch summary. Comma separated. No mail transport is wired up
# yet, so this is only logged; the report itself is kept in the batch_reports table.
SONGA_HR_EMAILS=hr@oneacrefund.org

# Proof images now live in the database. This is only where `npm run proofs:import`
# looks for images saved before that. Defaults to server/uploads.
# SONGA_UPLOAD_DIR=

# Set to true to run the API without the cycle cron jobs.
# SONGA_DISABLE_SCHEDULER=true
