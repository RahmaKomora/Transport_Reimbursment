# Copy to .env and fill in. Credentials are REQUIRED: Songa reads every role, budget and
# manager assignment from the Google Sheet and keeps no local copy, so without them the
# API refuses every request rather than assuming anyone's permissions.

# The staff spreadsheet. Defaults to the Tupande sheet if unset.
SONGA_SHEET_ID=1hcLnhUcH7kLUCCeC5Lai4D9VnNnnhBd_7v3W3Y7gOBs

# Tab names. Users is read; Claims is created by the app if it does not exist.
SONGA_USERS_TAB=Users
SONGA_CLAIMS_TAB=Claims

# Service account credentials. Use ONE of these.
#  1. Path to the downloaded key file (keep it outside the repo, or it will be committed):
GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/songa-service-account.json
#  2. Or the same JSON on a single line:
# SONGA_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Sign session tokens. Any long random string; change it and everyone is signed out.
SONGA_SESSION_SECRET=change-me

SONGA_API_PORT=5175

# How long a read of the staff sheet is reused before it is re-read. Lower means sheet
# edits land sooner; higher means fewer API calls. The Refresh Sheet Data button bypasses
# it entirely.
SONGA_SHEET_TTL_MS=60000

# Who receives the cycle batch summary. Comma separated. No mail transport is wired up
# yet, so this is currently only reported in the log alongside the written report.
SONGA_HR_EMAILS=hr@oneacrefund.org

# Where batch reports are written. Defaults to server/reports.
# SONGA_REPORT_DIR=

# Set to true to run the API without the cycle cron jobs.
# SONGA_DISABLE_SCHEDULER=true
