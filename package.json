{
  "name": "transport-allocation-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "auth:check": "node server/authCheck.js",
    "admin:unlock": "node server/unlock.js",
    "db:setup": "node server/setupPostgres.js",
    "proofs:import": "node server/importProofs.js",
    "export:postgres": "node server/exportForPostgres.js",
    "dev:all": "concurrently -n web,api -c green,cyan \"npm run dev\" \"npm run server\"",
    "lint": "eslint .",
    "test": "node --test server/*.test.js",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "node-cron": "^4.6.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0"
  }
}
